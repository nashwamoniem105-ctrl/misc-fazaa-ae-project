{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm i -g pnpm && pnpm install --frozen-lockfile && pnpm build"
  },
  "deploy": {
    "startCommand": "pnpm dlx serve -s dist -l $PORT",
    "healthcheckPath": "/",
    "restartPolicy": "ON_FAILURE"
  }
}
